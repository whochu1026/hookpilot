# Database (host port 5435 → container 5432)
DATABASE_URL="postgresql://hookpilot:hookpilot@localhost:5435/hookpilot?schema=public"

# Redis (host port 6382 → container 6379)
REDIS_HOST=localhost
REDIS_PORT=6382

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# App
PORT=3001
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# One-click demo login (forced off when NODE_ENV=production)
DEMO_LOGIN_ENABLED=true

# Webhook delivery
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_TIMEOUT_MS=10000
# Demo tip: set to 2 for a faster retry showcase
WEBHOOK_BACKOFF_BASE_SECONDS=10
